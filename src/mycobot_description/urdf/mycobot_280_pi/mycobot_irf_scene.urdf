<?xml version="1.1"?>
<robot  xmlns:xacro="http://www.ros.org/wiki/xacro" name="firefighter" >
	
<xacro:property name="width" value=".2" />

  <link name="g_base">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/G_base.dae"/>
      </geometry>
      <origin xyz = "0.0 0 -0.03" rpy = "0 0 1.5708"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/G_base.dae"/>
      </geometry>
      <origin xyz = "0.0 0 -0.03" rpy = "0 0 1.5708"/>
    </collision>
  </link>

  <link name="joint1">
    <visual>
      <geometry>
	     <!--- 0.0 0 -0.04  1.5708 3.14159-->
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint1.dae"/>
      </geometry>
      <origin xyz = "0.0 0 0 " rpy = " 0 0 -1.5708"/>
    </visual>
    <collision>
      <geometry>
	     <!--- 0.0 0 -0.04  1.5708 3.14159-->
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint1.dae"/>
        </geometry>
        <origin xyz = "0.0 0 0 " rpy = " 0 0 -1.5708"/>
    </collision>
  </link>

  <link name="joint2">
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint2.dae"/>
      </geometry>
      <origin xyz = "0.0 0 -0.06096 " rpy = " 0 0 -1.5708"/>
    </visual>
    <collision>
     <geometry>
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint2.dae"/>
      </geometry>
      <origin xyz = "0.0 0 -0.06096 " rpy = " 0 0 -1.5708"/>
    </collision>
  </link>


  <link name="joint3">
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint3.dae"/>
      </geometry>
    <origin xyz = "0.0 0 0.03256 " rpy = " 0 -1.5708 0"/>
    </visual>
    <collision>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint3.dae"/>
      </geometry>
      <origin xyz = "0.0 0 0.03256 " rpy = " 0 -1.5708 0"/>
    </collision>
  </link>


  <link name="joint4">
    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint4.dae"/>
      </geometry>
      <origin xyz = "0.0 0 0.03056 " rpy = " 0 -1.5708 0"/>
    </visual>
    <collision>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint4.dae"/>
      </geometry>
      <origin xyz = "0.0 0 0.03056 " rpy = " 0 -1.5708 0"/>
    </collision>
  </link>


  <link name="joint5">
    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint5.dae"/>
      </geometry>
    <origin xyz = "0.0 0 -0.03356 " rpy = " -1.5708 0 0"/>
    </visual>
    <collision>
       <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint5.dae"/>
      </geometry>
      <origin xyz = "0.0 0 -0.03356 " rpy = " -1.5708 0 0"/>
    </collision>
  </link>


  <link name="joint6">
    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint6.dae"/>
      </geometry>
    <origin xyz = "0 0.00 -0.038 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint6.dae"/>
      </geometry>
    <origin xyz = "0 0.00 -0.038 " rpy = " 0 0 0"/>
    </collision>
  </link>


  <link name="joint6_flange">
    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint7.dae"/>
      </geometry>
    <origin xyz = "0.0 0 -0.012 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint7.dae"/>
      </geometry>
    <origin xyz = "0.0 0 -0.012 " rpy = " 0 0 0"/>
    </collision>
  </link>

  <link name="pump_head">
    <visual>
      <geometry>
        <cylinder radius="0.015" length="0.08"/>
      </geometry>
      <material name="white_color">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    <origin xyz = "0.0 0.0 0.0 " rpy = "0 0 1.5708"/>
    </visual>
    <collision>
      <geometry>
       <cylinder radius="0.015" length="0.08"/>
      </geometry>
    <origin xyz = "0.0 0.0 0.0 " rpy = "0 0 1.5708"/>
    </collision>
  </link>


  <joint name="g_base_to_joint1" type="fixed">
    <axis xyz="0 0 0"/>
    <limit effort = "1000.0" lower = "-3.14" upper = "3.14159" velocity = "0"/>
    <parent link="g_base"/>
    <child link="joint1"/>
    <origin xyz= "0 0 0" rpy = "0 0 0"/>  
  </joint>

  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-2.9321" upper = "2.9321" velocity = "0"/>
    <parent link="joint1"/>
    <child link="joint2"/>
    <origin xyz= "0 0 0.13156" rpy = "0 0 0"/>  
  </joint>


  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-2.4434" upper = "2.4434" velocity = "0"/>
    <parent link="joint2"/>
    <child link="joint3"/>
    <origin xyz= "0 0  0" rpy = "0 1.5708 -1.5708"/>  
  </joint>


  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort = "1000.0" lower = "-2.6179" upper = "2.6179" velocity = "0"/>
    <parent link="joint3"/>
    <child link="joint4"/>
    <origin xyz= "  -0.1104 0 0   " rpy = "0 0 0"/>  
  </joint>


  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort = "1000.0" lower = "-2.6179" upper = "2.6179" velocity = "0"/>
    <parent link="joint4"/>
    <child link="joint5"/>
    <origin xyz= "-0.096 0 0.06462" rpy = "0 0 -1.5708"/>  
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-2.7052" upper = "2.7925" velocity = "0"/>
    <parent link="joint5"/>
    <child link="joint6"/>
    <origin xyz= "0 -0.07318 0" rpy = "1.5708 -1.5708 0"/>  
  </joint>

  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-3.14159" upper = "3.14159" velocity = "0"/>
    <parent link="joint6"/>
    <child link="joint6_flange"/>
    <origin xyz= "0 0.0456 0" rpy = "-1.5708 0 0"/>  
  </joint>

  <joint name="joint6output_to_pump_head" type="fixed">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-3.14" upper = "3.14159" velocity = "0"/>
    <parent link="joint6_flange"/>
    <child link="pump_head"/>
    <origin xyz= "0 0 0.04" rpy = "0 0 0"/>  
  </joint>


<link name="world"/>

  <link name="env_table">
    <visual>
      <geometry><box size="1.0 1.0 0.01"/></geometry>
      <material name="wood">
        <color rgba="0.6 0.4 0.2 1.0"/> </material>
    </visual>
    <collision>
      <geometry><box size="1.0 1.0 0.01"/></geometry>
    </collision>
  </link>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="env_table"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
  </joint>

  <link name="env_camera">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="black_color"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.06" length="0.06"/></geometry>
    </collision>
  </link>
  <joint name="world_to_camera" type="fixed">
    <parent link="world"/>
    <child link="env_camera"/>
    <origin xyz="0.16 0 0.39" rpy="0 0 0"/>
  </joint>

  <link name="env_camera_mount1">
    <visual>
      <geometry><box size="0.11 0.03 0.03"/></geometry>
      <material name="black_color"/>
    </visual>
    <collision>
      <geometry><box size="0.11 0.06 0.06"/></geometry>
    </collision>
  </link>
  <joint name="world_to_mount1" type="fixed">
    <parent link="world"/>
    <child link="env_camera_mount1"/>
    <origin xyz="0.26 0 0.39" rpy="0 0 0"/>
  </joint>

  <link name="env_camera_mount2">
    <visual>
      <geometry><box size="0.03 0.03 0.40"/></geometry>
      <material name="black_color"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.06 0.40"/></geometry>
    </collision>
  </link>
  <joint name="world_to_mount2" type="fixed">
    <parent link="world"/>
    <child link="env_camera_mount2"/>
    <origin xyz="0.3 0 0.20" rpy="0 0 0"/>
  </joint>

  <link name="env_power_bar">
    <visual>
      <geometry><box size="0.07 1.0 0.15"/></geometry>
      <material name="white_color"><color rgba="1.0 1.0 1.0 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.07 1.0 0.15"/></geometry>
    </collision>
  </link>
  <joint name="world_to_power_bar" type="fixed">
    <parent link="world"/>
    <child link="env_power_bar"/>
    <origin xyz="-0.29 0 0.34" rpy="0 0 0"/>
  </joint>

  <joint name="world_to_robot_base" type="fixed">
    <parent link="world"/>
    <child link="g_base"/> 
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


</robot>